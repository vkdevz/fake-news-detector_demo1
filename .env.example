# TruthLens Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database
DATABASE_URL=sqlite:///./truthlens.db

# External API Keys (Optional - System automatically falls back to offline/local verified cache when empty)
GOOGLE_FACT_CHECK_API_KEY=
SERPAPI_API_KEY=
GROQ_API_KEY=

# System Modes
DEFAULT_RETRIEVAL_MODE=hybrid # options: live, offline, hybrid
ENABLE_RATE_LIMITING=true
MAX_CLAIMS_PER_ARTICLE=6
